# Public app config
VITE_APP_NAME="AdaptiveGuard AI"
VITE_APP_ENV="development"            # development | preview | staging | production

# Observability (optional in dev)
VITE_SENTRY_DSN=""
VITE_OTEL_ENDPOINT="http://localhost:4318/v1/traces"

# Backend API integration (set to "true" to use real backend, otherwise mocks)
VITE_USE_REAL_API=false

# Behavioral data export for ML training
# Set to "true" to auto-persist feature windows to localStorage across sessions.
# Alternatively, append ?export-behavioral to any URL for the export panel.
VITE_BEHAVIORAL_EXPORT=false

# Feature flags (optional in dev — falls back to registry defaults)
VITE_LD_CLIENT_ID=""

# Server-only — never prefixed with VITE_
# DATABASE_URL="postgres://adaptiveguard:adaptiveguard@localhost:5432/adaptiveguard"
# REDIS_URL="redis://localhost:6379"
# KAFKA_BROKERS="localhost:9092"
# JWT_KMS_KEY_ID=""
# SES_REGION="eu-west-1"
