# =============================================================================
# AdaptiveGuard Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# ── App ──────────────────────────────────────────────────────────────
APP_NAME=AdaptiveGuard
DEBUG=false

# ── MongoDB Atlas ─────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=adaptive_guardian

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URI=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-strong-random-secret-at-least-64-chars
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=3
# OTP_LENGTH=6

# ── Password Reset ────────────────────────────────────────────────────
# PASSWORD_RESET_TTL_SECONDS=900
# PASSWORD_MIN_LENGTH=12

# ── Rate Limiting ─────────────────────────────────────────────────────
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# ── ML Engine (disabled by default until Sprint 8+) ───────────────────
# ML_ENABLED=false
# MODEL_BUCKET=guardian-models
# THRESHOLD_ALLOW=0.85
# THRESHOLD_WARN=0.60

# ── Email (dev: use Mailpit on localhost:1025) ────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@adaptiveguard.ai

# ── MinIO (model artifact storage) ────────────────────────────────────
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=guardian-models
# MINIO_SECURE=false
