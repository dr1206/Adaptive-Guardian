# =============================================================================
# AdaptiveGuard Backend — Environment Configuration Template
# =============================================================================

# ── App Environment ──────────────────────────────────────────────────────────
APP_NAME=AdaptiveGuard
APP_ENV=development # development | test | staging | production
DEBUG=true

# ── CORS (comma-separated origins) ───────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# ── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_guardian

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URI=redis://localhost:6379

# ── Cryptography & Security ───────────────────────────────────────────────────
# In production, must be at least 32 characters of high-entropy random bytes
JWT_SECRET=dev-secret-change-in-production-local-dev-only-do-not-use-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ── OTP & Verification ────────────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_LENGTH=6

# ── Password Policy ───────────────────────────────────────────────────────────
PASSWORD_RESET_TTL_SECONDS=900
PASSWORD_MIN_LENGTH=12

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Behavioral ML Engine ──────────────────────────────────────────────────────
ML_ENABLED=true
MODEL_BUCKET=guardian-models
THRESHOLD_ALLOW=0.85
THRESHOLD_WARN=0.60

# ── Email / Notifications ─────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=noreply@adaptiveguard.ai

# ── Model Artifact Storage (MinIO / S3) ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=guardian-models
MINIO_SECURE=false

# ── Initial Admin Seed (First Startup Only) ───────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@adaptiveguard.ai
DEFAULT_ADMIN_PASSWORD=Admin@1234567890
