{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AdaptiveGuardianFeatureSchema",
  "description": "Authoritative canonical feature definitions shared between training and live inference",
  "window_duration_seconds": 30,
  "features": [
    {
      "name": "accelerationMean",
      "index": 0,
      "unit": "px/s/ms",
      "formula": "mean((vel[i] - vel[i-1]) / dt_ms)",
      "min_val": -10.0,
      "max_val": 10.0,
      "default_missing": 0.0,
      "description": "Mean cursor acceleration"
    },
    {
      "name": "accelerationStd",
      "index": 1,
      "unit": "px/s/ms",
      "formula": "std((vel[i] - vel[i-1]) / dt_ms)",
      "min_val": 0.0,
      "max_val": 10.0,
      "default_missing": 0.0,
      "description": "Standard deviation of cursor acceleration"
    },
    {
      "name": "clickCount",
      "index": 2,
      "unit": "count",
      "formula": "len(click_events)",
      "min_val": 0.0,
      "max_val": 100.0,
      "default_missing": 0.0,
      "description": "Total mouse clicks in window"
    },
    {
      "name": "curvatureMean",
      "index": 3,
      "unit": "radians",
      "formula": "mean(acos(clamp(dot(v1, v2) / (|v1| * |v2|), -1, 1)))",
      "min_val": 0.0,
      "max_val": 3.141593,
      "default_missing": 0.0,
      "description": "Mean angle deflection between consecutive trajectory segments"
    },
    {
      "name": "curvatureStd",
      "index": 4,
      "unit": "radians",
      "formula": "std(curvature_angles)",
      "min_val": 0.0,
      "max_val": 3.141593,
      "default_missing": 0.0,
      "description": "Standard deviation of trajectory curvature"
    },
    {
      "name": "dwellMeanMs",
      "index": 5,
      "unit": "ms",
      "formula": "mean(keyup_time - keydown_time)",
      "min_val": 0.0,
      "max_val": 2000.0,
      "default_missing": 0.0,
      "description": "Mean key dwell (hold) time in milliseconds"
    },
    {
      "name": "dwellStdMs",
      "index": 6,
      "unit": "ms",
      "formula": "std(keyup_time - keydown_time)",
      "min_val": 0.0,
      "max_val": 2000.0,
      "default_missing": 0.0,
      "description": "Standard deviation of key dwell time in milliseconds"
    },
    {
      "name": "flightMeanMs",
      "index": 7,
      "unit": "ms",
      "formula": "mean(next_keydown_time - keydown_time)",
      "min_val": 0.0,
      "max_val": 2000.0,
      "default_missing": 0.0,
      "description": "Mean key flight (inter-key interval) time in milliseconds"
    },
    {
      "name": "flightStdMs",
      "index": 8,
      "unit": "ms",
      "formula": "std(flight_times)",
      "min_val": 0.0,
      "max_val": 2000.0,
      "default_missing": 0.0,
      "description": "Standard deviation of key flight time in milliseconds"
    },
    {
      "name": "keysPerSec",
      "index": 9,
      "unit": "keys/s",
      "formula": "len(dwell_times) / window_duration_sec",
      "min_val": 0.0,
      "max_val": 25.0,
      "default_missing": 0.0,
      "description": "Keystroke frequency in keys per second"
    },
    {
      "name": "mouseTravelPx",
      "index": 10,
      "unit": "px",
      "formula": "sum(sqrt(dx^2 + dy^2))",
      "min_val": 0.0,
      "max_val": 100000.0,
      "default_missing": 0.0,
      "description": "Total Euclidean distance traveled by cursor"
    },
    {
      "name": "scrollAmount",
      "index": 11,
      "unit": "px",
      "formula": "sum(abs(wheel_delta_y))",
      "min_val": 0.0,
      "max_val": 50000.0,
      "default_missing": 0.0,
      "description": "Total cumulative vertical scroll distance"
    },
    {
      "name": "velocityMean",
      "index": 12,
      "unit": "px/s",
      "formula": "mean(min((dist / dt_ms) * 1000, 8000))",
      "min_val": 0.0,
      "max_val": 8000.0,
      "default_missing": 0.0,
      "description": "Mean cursor velocity in pixels per second"
    },
    {
      "name": "velocityStd",
      "index": 13,
      "unit": "px/s",
      "formula": "std(velocities_px_per_s)",
      "min_val": 0.0,
      "max_val": 8000.0,
      "default_missing": 0.0,
      "description": "Standard deviation of cursor velocity in pixels per second"
    }
  ]
}
